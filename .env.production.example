# Public URL used by the users' browser. Required by the SvelteKit Node server.
ORIGIN=https://wikiforge.roselaqueen.fr

# Leave blank when the NAS reverse proxy routes https://app.example.com/api
# to the API. Otherwise set the public API URL, for example:
PUBLIC_API_BASE_URL=https://wikiforge-api.roselaqueen.fr

# Local port published by Portainer. This port must be the target of the NAS
# reverse-proxy rule for the frontend hostname.
FRONTEND_PORT=32000
