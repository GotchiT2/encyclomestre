# Public URL used by the users' browser. Required by the SvelteKit Node server.
ORIGIN=https://www.wikiforge.fr

# Public endpoint for authenticated platform requests and OAuth2.
PUBLIC_API_BASE_URL=https://api.wikiforge.fr

# Public source of truth for global card search.
PUBLIC_CARDS_API_BASE_URL=https://api.wikiforge.fr

# Local port published by Portainer. This port must be the target of the NAS
# reverse-proxy rule for the frontend hostname.
FRONTEND_PORT=32000

# Required when the GitHub repository is private. Create a fine-grained GitHub
# token with read-only Contents access to GotchiT2/encyclomestre.
WIKIFORGE_FRONTEND_GIT_TOKEN=
